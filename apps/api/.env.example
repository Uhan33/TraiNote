# 복사해서 .env 로 사용: cp .env.example .env
PORT=4000
# 쉼표로 여러 개 지정 가능
CORS_ORIGIN=http://localhost:5173
# 로컬: docker compose up -d 로 띄운 Postgres
DATABASE_URL=postgres://trainote:trainote@localhost:5432/trainote
# 로그인 토큰 서명 키 — 운영에서는 반드시 긴 랜덤 값: openssl rand -base64 48
JWT_SECRET=change-me-local-dev-secret
# 운영에서 web·api 서브도메인 간 쿠키 공유 시: .도메인.com (로컬은 비워둠)
COOKIE_DOMAIN=
