# DOMAIN 으로 https 인증서 자동 발급(Let's Encrypt)·갱신
{$DOMAIN} {
	encode zstd gzip

	# API — 같은 주소에서 프록시하므로 쿠키·CORS 설정이 로컬 개발과 같음
	handle /api/* {
		reverse_proxy api:4000
	}

	# 웹 — 없는 경로는 index.html (SPA)
	handle {
		root * /srv
		# 파일명에 해시가 붙은 빌드 결과는 오래 캐시, 나머지(index.html·서비스 워커·manifest)는 매번 확인 → 배포 즉시 반영
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# www 로 들어오면 대표 주소로 영구 이동 — 쿠키·설치 앱(PWA)이 주소별로 갈리지 않게 한 주소만 사용
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
