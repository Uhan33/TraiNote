# 서버에서 복사해 사용: cp deploy/.env.example deploy/.env — 값은 아래 명령으로 생성
# 서비스 주소 (도메인 연결 전 테스트: <IP 의 . 을 - 로>.sslip.io, 예: 16-184-58-31.sslip.io)
DOMAIN=trainote.kr
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# 매일 DB 백업 받을 S3 버킷 (deploy/backup.sh)
BACKUP_BUCKET=trainote-backups-847547470208
# 운영 알림(디스크·백업 실패) SNS 토픽 (deploy/alert.sh)
ALERT_TOPIC_ARN=arn:aws:sns:ap-northeast-2:847547470208:trainote-alerts
# 회원 푸시 알림 (일지 작성 완료 시). 한 번 만들고 바꾸지 않음 — 바꾸면 기존 구독이 모두 끊김
# 만들기: docker compose -f deploy/docker-compose.yml exec api npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
